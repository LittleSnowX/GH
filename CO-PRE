task.spawn(function()
    local MissionsRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Missions")
    local UtilsModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Utils"))
    local MissionsData = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Datas"):WaitForChild("Missions"))

    while task.wait(5) do
        if not getgenv().AutoClaimMissions then continue end

        pcall(function()
            local rawData = Player:GetAttribute("Missions")
            if not rawData or rawData == "" then return end

            local success, decodedMissions = pcall(function()
                return UtilsModule.fastDecode(rawData)
            end)

            if success and type(decodedMissions) == "table" then
                local categories = {"Daily", "Weekly"}

                for _, category in ipairs(categories) do
                    if decodedMissions[category] then
                        for missionName, missionProgress in pairs(decodedMissions[category]) do

                            if missionProgress.Completed == true then
                                local claimedRewards = missionProgress.ClaimedRewards or {}
                                local baseMissionData = MissionsData[category] and MissionsData[category][missionName]

                                if baseMissionData and baseMissionData.Rewards then
                                    for rewardIndex, rewardInfo in ipairs(baseMissionData.Rewards) do
                                        if not claimedRewards[tostring(rewardIndex)] then
                                            Notify({
                                                Title = "Mission Claimed",
                                                Duration = 3,
                                                Icon = true
                                            })

                                            MissionsRemote:FireServer("ClaimReward", {
                                                ["Category"] = category,
                                                ["MissionName"] = missionName,
                                                ["RewardIndex"] = rewardIndex
                                            })
                                            task.wait(10)
                                        end
                                    end
                                end
                            end

                        end
                    end
                end
            end
        end)
    end
end)


local POPUP_CLICK_DELAY = 0.45
local lastSpinPopupClick = {
    Grimoire = 0,
    Trait = 0,
    Broom = 0,
}

local function getActiveSpinAutoCount()
    local count = 0
    if getgenv().AutoRerollGrimoire then count += 1 end
    if getgenv().AutoRerollTrait then count += 1 end
    if getgenv().AutoRerollBroom then count += 1 end
    return count
end

local function isGuiVisible(obj)
    local current = obj

    while current and current ~= PlayerGui do
        if current:IsA("ScreenGui") and current.Enabled == false then
            return false
        end

        if current:IsA("GuiObject") and current.Visible == false then
            return false
        end

        current = current.Parent
    end

    return true
end

local function getGuiText(obj)
    local texts = {}

    if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
        table.insert(texts, tostring(obj.Text or ""))
    end

    table.insert(texts, tostring(obj.Name or ""))

    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
            table.insert(texts, tostring(child.Text or ""))
        end

        table.insert(texts, tostring(child.Name or ""))
    end

    return table.concat(texts, " ")
end

local function findResultPopupButtons()
    local rerollButton = nil
    local keepButton = nil

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and isGuiVisible(obj) then
            local text = normalizeText(getGuiText(obj)) or ""

            if text:find("reroll", 1, true) then
                rerollButton = obj
            elseif text:find("keep", 1, true) then
                keepButton = obj
            end
        end
    end

    return rerollButton, keepButton
end

local function findCommonPopupRoot(buttonA, buttonB)
    if not buttonA then return nil end

    local aAncestors = {}
    local current = buttonA

    while current and current ~= PlayerGui do
        aAncestors[current] = true
        current = current.Parent
    end

    current = buttonB or buttonA.Parent
    while current and current ~= PlayerGui do
        if aAncestors[current] then
            return current
        end
        current = current.Parent
    end

    return buttonA.Parent
end

local function getPopupResultFromRoot(root, resolver)
    if not root or type(resolver) ~= "function" then return nil end

    local scanRoot = root
    local current = root


    for _ = 1, 4 do
        if current and current.Parent and current.Parent ~= PlayerGui then
            current = current.Parent
            if current:IsA("GuiObject") or current:IsA("ScreenGui") then
                scanRoot = current
            end
        end
    end

    local function checkObject(obj)
        local found = resolver(obj.Name)
        if found then return found end

        if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
            local rawText = tostring(obj.Text or "")
            local normalized = normalizeText(rawText) or ""

            if normalized ~= "reroll" and normalized ~= "keep" then
                found = resolver(rawText)
                if found then return found end
            end
        end

        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            found = resolver(obj.Image)
            if found then return found end
        end

        return nil
    end

    local found = checkObject(scanRoot)
    if found then return found end

    for _, obj in ipairs(scanRoot:GetDescendants()) do
        if isGuiVisible(obj) then
            found = checkObject(obj)
            if found then return found end
        end
    end

    return nil
end

local function clickGuiButton(button)
    if not button or not button.Parent then return false end

    local clicked = false

    pcall(function()
        if firesignal then
            firesignal(button.MouseButton1Down)
            firesignal(button.MouseButton1Click)
            firesignal(button.MouseButton1Up)
            firesignal(button.Activated)
            clicked = true
        end
    end)

    pcall(function()
        if getconnections then
            for _, connection in ipairs(getconnections(button.MouseButton1Click)) do
                pcall(function() connection:Fire() end)
                clicked = true
            end

            for _, connection in ipairs(getconnections(button.Activated)) do
                pcall(function() connection:Fire() end)
                clicked = true
            end
        end
    end)

    pcall(function()
        if VirtualInputManager then
            local position = button.AbsolutePosition + (button.AbsoluteSize / 2)
            VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 0)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
            clicked = true
        end
    end)

    return clicked
end

local function handleSpinResultPopup(config)
    local rerollButton, keepButton = findResultPopupButtons()
    if not rerollButton and not keepButton then
        return false
    end

    local kind = config.Kind
    local now = os.clock()

    if now - (lastSpinPopupClick[kind] or 0) < POPUP_CLICK_DELAY then
        return true
    end

    local popupRoot = findCommonPopupRoot(rerollButton, keepButton)
    local resultName = getPopupResultFromRoot(popupRoot, config.Resolver)

    if resultName then
        if config.IsTarget(resultName) then
            if keepButton then
                lastSpinPopupClick[kind] = now
                clickGuiButton(keepButton)
            end

            getgenv()[config.EnabledKey] = false
            Notify({
                Title = "Auto Reroll " .. kind,
                Description = "Obtained: " .. tostring(resultName) .. " — kept automatically",
                Duration = 5,
                Icon = true
            })

            return true
        end

        if rerollButton then
            lastSpinPopupClick[kind] = now
            clickGuiButton(rerollButton)
            return true
        end

        return true
    end


    if getgenv()[config.EnabledKey] and getActiveSpinAutoCount() <= 1 and rerollButton then
        lastSpinPopupClick[kind] = now
        clickGuiButton(rerollButton)
    end


    return true
end

