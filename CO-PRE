local function getMobsNearMob(targetMob, radius)
    local mobRoot = targetMob and targetMob:FindFirstChild("HumanoidRootPart")
    if not mobRoot then
        return targetMob and { targetMob } or {}
    end

    local nearby = getMobsNearPosition(mobRoot.Position, radius or DUNGEON_ATTACK_RADIUS)
    if #nearby <= 0 and targetMob then
        table.insert(nearby, targetMob)
    end
    return nearby
