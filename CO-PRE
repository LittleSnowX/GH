local function normalizeText(value)
    if typeof(value) == "string" then return value:gsub("%s+", ""):gsub("_", ""):gsub("-", ""):lower() end
    return nil
end

local function resolveGrimoireName(value)
    local normalized = normalizeText(value)
    if not normalized then return nil end
    for _, name in ipairs(grimoireNames) do
        if normalized == normalizeText(name) then return name end
    end
    for _, name in ipairs(grimoireNames) do
        if normalized:find(normalizeText(name), 1, true) then return name end
    end
    return nil
end

local function resolveNameFromList(value, names)
    local normalized = normalizeText(value)
    if not normalized or type(names) ~= "table" then return nil end

    for _, name in ipairs(names) do
        if normalized == normalizeText(name) then return name end
    end

    for _, name in ipairs(names) do
        local check = normalizeText(name)
        if check and normalized:find(check, 1, true) then
            return name
        end
    end

    return nil
end

local function resolveTraitName(value)
    return resolveNameFromList(value, traitNames)
end

local function resolveBroomName(value)
    return resolveNameFromList(value, broomNames)
end

local function normalizeTargetGrimoires()
    local targets = getgenv().TargetGrimoires

    if type(targets) ~= "table" then
        targets = {}
    end

    local normalizedTargets = {}

    for key, value in pairs(targets) do
        local candidate = nil

        if type(key) == "number" then
            candidate = value
        elseif value == true then
            candidate = key
        elseif type(value) == "string" then
            candidate = value
        end

        local resolved = resolveGrimoireName(candidate) or (candidate and tostring(candidate))
        if resolved and resolved ~= "" then
            normalizedTargets[resolved] = true
        end
    end

    getgenv().TargetGrimoires = normalizedTargets
    return normalizedTargets
end

local function setTargetGrimoire(name)
