local function getDungeonSpawnsFolder()
    return Workspace:FindFirstChild("DungeonSpawns")
end

local function getDungeonWaveFolders()
    local folder = getDungeonSpawnsFolder()
    local waves = {}

    if not folder then
        return waves
    end

    for _, wave in ipairs(folder:GetChildren()) do
        local waveNumber = tonumber(tostring(wave.Name):match("%d+"))
        if waveNumber then
            table.insert(waves, {
                Number = waveNumber,
                Folder = wave,
            })
        end
    end

    table.sort(waves, function(a, b)
        return a.Number < b.Number
    end)

    return waves
end

local function getPositionFromInstance(instance)
    if not instance then return nil end

    if instance:IsA("BasePart") then
        return instance.Position
    end

    if instance:IsA("Attachment") then
        return instance.WorldPosition
    end

    if instance:IsA("Model") then
        local ok, pivot = pcall(function()
            return instance:GetPivot()
        end)

        if ok and pivot then
            return pivot.Position
        end
    end

    return nil
end

local function getWavePosition(waveFolder)
    if not waveFolder then return nil end

    local direct = getPositionFromInstance(waveFolder)
    if direct then
        return direct
    end

    for _, obj in ipairs(waveFolder:GetDescendants()) do
        local pos = getPositionFromInstance(obj)
        if pos then
            return pos
        end
    end

    return nil
end

local function isDungeonMobModel(model)
    if not model or not model:IsA("Model") then return false end
    if model == Player.Character then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 then
        return false
    end

    if Players:GetPlayerFromCharacter(model) then
        return false
    end

    if model:GetAttribute("Invulnerable") or CollectionService:HasTag(model, "Invulnerable") then
        return false
    end

    return true
end

local function addDungeonMobCandidate(model, mobs, seen, centerPosition, radius)
    if not model or seen[model] then return end
    if not isDungeonMobModel(model) then return end

    local root = model:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if centerPosition and radius then
        if (root.Position - centerPosition).Magnitude > radius then
            return
        end
    end

    seen[model] = true
    table.insert(mobs, model)
end

local function getDungeonMobContainers()
    return {
        Workspace:FindFirstChild("NPCs"),
        Workspace:FindFirstChild("Npcs"),
        Workspace:FindFirstChild("Mobs"),
        Workspace:FindFirstChild("Enemies"),
        Workspace:FindFirstChild("Live"),
        Workspace:FindFirstChild("Dungeon"),
        Workspace:FindFirstChild("DungeonMobs"),
    }
end

local function getMobsNearPosition(centerPosition, radius)
    local mobs = {}
    local seen = {}

    if not centerPosition then
        return mobs
    end

    for _, container in ipairs(getDungeonMobContainers()) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("Humanoid") then
                    addDungeonMobCandidate(obj.Parent, mobs, seen, centerPosition, radius)
                elseif obj:IsA("Model") then
                    addDungeonMobCandidate(obj, mobs, seen, centerPosition, radius)
                end
            end
        end
    end

    for _, tagName in ipairs({ "AI", "NPC", "Mob", "Enemy", "DungeonMob" }) do
        pcall(function()
            for _, model in ipairs(CollectionService:GetTagged(tagName)) do
                addDungeonMobCandidate(model, mobs, seen, centerPosition, radius)
            end
        end)
    end

    return mobs
end

local function getClosestMobFromList(mobs)
    local char = getCharacter()
    local root = getRoot(char)
    if not root then return mobs and mobs[1] or nil end

    local closest = nil
    local shortest = math.huge

    for _, mob in ipairs(mobs or {}) do
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if mobRoot then
            local distance = (root.Position - mobRoot.Position).Magnitude
            if distance < shortest then
                shortest = distance
                closest = mob
            end
        end
    end

    return closest
end

local function getDungeonWaveNumber()
