local function joinDungeonOnce(reason)
    local remote = refreshDungeonRemote()
    if not remote then
        Notify({
            Title = "Dungeon",
            Description = "DungeonJoin remote was not found.",
            Duration = 4,
            Icon = true
        })
        return false
    end

    if DungeonJoinInProgress then
        return false
    end

    if os.clock() - LastDungeonJoin < DungeonJoinCooldown then
        Notify({
            Title = "Dungeon",
            Description = "Join blocked by cooldown.",
            Duration = 3,
            Icon = true
        })
        getgenv().AutoDungeonJoin = false
        return false
    end

    local keyCount = getDungeonKeyCount()
    if keyCount ~= nil and keyCount <= 0 then
        Notify({
            Title = "Dungeon",
            Description = "No Dungeon Key detected. Join cancelled.",
            Duration = 4,
            Icon = true
        })
        getgenv().AutoDungeonJoin = false
        return false
    end

    local mode = tostring(getgenv().SelectedDungeonMode or "Solo")
    if mode ~= "Solo" and mode ~= "Party" and mode ~= "MatchMaking" then
        mode = "Solo"
        getgenv().SelectedDungeonMode = mode
    end

    DungeonJoinInProgress = true
    LastDungeonJoin = os.clock()
    getgenv().AutoDungeonJoin = false
    SaveConfig()

    Notify({
        Title = "Dungeon",
        Description = "Joining dungeon: " .. mode,
        Duration = 4,
        Icon = true
    })

    local ok, err = pcall(function()
        remote:FireServer("Play", mode)
    end)

    task.delay(3, function()
        DungeonJoinInProgress = false
    end)

    if not ok then
        Notify({
            Title = "Dungeon",
            Description = "Join failed: " .. tostring(err),
            Duration = 4,
            Icon = true
        })
        return false
    end

    return true
end

