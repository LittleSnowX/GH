local function equipSelectedTool(tool, char, forceHotbarClick)
    if not tool then return nil end
    char = char or getCharacter()

    local hum = getHumanoid(char)
    if not hum then return tool end

    local selectedName = tool.Name
    local currentTool = char:FindFirstChildOfClass("Tool")

    if currentTool and currentTool ~= tool then
        pcall(function()
            hum:UnequipTools()
        end)
        task.wait(0.05)
    end

    if tool.Parent ~= char then
        pcall(function()
            hum:EquipTool(tool)
        end)

        local start = os.clock()
        while tool.Parent ~= char and os.clock() - start < 0.5 do
            task.wait()
        end
    end


    if forceHotbarClick and os.clock() - lastSelectedCombatEquip >= 0.35 then
        lastSelectedCombatEquip = os.clock()
        task.defer(function()
            clickHotbarToolByName(selectedName)
        end)
    end

    return char:FindFirstChild(selectedName) or tool
end

local function getTool(char)
    char = char or getCharacter()

    local selectedCombat = tostring(getgenv().SelectedCombat or "Auto")
    if selectedCombat ~= "" and selectedCombat ~= "Auto" then
        local selectedTool = findToolByName(selectedCombat)
        if selectedTool then
            return equipSelectedTool(selectedTool, char, true)
        end
    end

    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = Player:FindFirstChild("Backpack")
        tool = backpack and backpack:FindFirstChildOfClass("Tool")
        if tool then
            tool = equipSelectedTool(tool, char, false)
        end
    end

    return tool
end

