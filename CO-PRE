local function getCurrentLevel()
    local level = 0
    pcall(function()
        local interface = PlayerGui:FindFirstChild("Interface Player")
        if interface then
            local labelText = interface.FrameBars.HUD.LabelLevel.Text:lower()
            labelText = string.gsub(labelText, ",", "")

            local numStr, suffix = string.match(labelText, "([%d%.]+)([kmb]?)")
            if numStr then
                local num = tonumber(numStr)
                if num then
                    if suffix == "k" then
                        num = num * 1000
                    elseif suffix == "m" then
                        num = num * 1000000
                    elseif suffix == "b" then
                        num = num * 1000000000
                    end
                    level = math.floor(num)
                end
            end
        end
    end)

    if level == 0 then
        level = Player:GetAttribute("Level") or 0
    end

    return level
end

local function getBestQuestInfo()
    local level         = getCurrentLevel()
    local bestQuestKey  = nil
    local bestQuestName = nil
    local maxLvlReq     = -1

    for key, data in pairs(Interacts) do
        if data.InteractType == "QuestGiver" and data.QuestData then
            if data.QuestData.PrimaryQuest == true then
                local lvlReq = data.QuestData.LvlReq or 0
                if typeof(lvlReq) == "number" and level >= lvlReq then
                    if lvlReq > maxLvlReq then
                        maxLvlReq = lvlReq
                        bestQuestKey = key
                        bestQuestName = data.QuestData.Quest
                    end
                end
            end
        end
    end

    return bestQuestKey, bestQuestName
end

