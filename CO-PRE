local function scanAttributesForList(instance, attrNames, names, resolver)
    if not instance then return nil end

    for _, attr in ipairs(attrNames) do
        local found = resolver(instance:GetAttribute(attr))
        if found then return found end
    end

    for _, attr in pairs(instance:GetAttributes()) do
        local found = resolver(attr)
        if found then return found end
    end

    return nil
end

local function scanContainerForList(container, attrNames, names, resolver)
    if not container then return nil end

    local found = scanAttributesForList(container, attrNames, names, resolver)
        or resolver(container.Name)
        or resolver(readValueObject(container))

    if found then return found end

    for _, obj in ipairs(container:GetDescendants()) do
        found = scanAttributesForList(obj, attrNames, names, resolver)
            or resolver(obj.Name)
            or resolver(readValueObject(obj))

        if found then return found end
    end

    return nil
end

