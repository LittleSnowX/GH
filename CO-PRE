local function serverHopForBoss()
    if BossHopInProgress then
        return
    end

    if os.clock() - BossHopLastTeleport < 8 then
        return
    end

    local req = getServerHopRequest()
    if not req then
        if os.clock() - BossHopNotifyCooldown > 5 then
            BossHopNotifyCooldown = os.clock()
            Notify({
                Title = "Boss Server Hop",
                Description = "Executor does not support HTTP request.",
                Duration = 4,
                Icon = true
            })
        end
        return
    end

    BossHopInProgress = true
    BossHopLastTeleport = os.clock()

    task.spawn(function()
        local success, err = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
            local res = req({ Url = url, Method = "GET" })

            if not res or not res.Success or not res.Body then
                error("Failed to fetch server list")
            end

            local data = HttpService:JSONDecode(res.Body)
            local candidates = {}

            for _, server in ipairs(data.data or {}) do
                if type(server) == "table"
                    and server.id
                    and server.id ~= game.JobId
                    and not BossHopVisitedServers[server.id]
                    and server.playing
                    and server.maxPlayers
                    and server.playing < server.maxPlayers
                then
                    table.insert(candidates, server.id)
                end
            end

            if #candidates == 0 then
                BossHopVisitedServers = { [game.JobId] = true }

                for _, server in ipairs(data.data or {}) do
                    if type(server) == "table"
                        and server.id
                        and server.id ~= game.JobId
                        and server.playing
                        and server.maxPlayers
                        and server.playing < server.maxPlayers
                    then
                        table.insert(candidates, server.id)
                    end
                end
            end

            if #candidates == 0 then
                error("No available server found")
            end

            local targetJobId = candidates[math.random(1, #candidates)]
            BossHopVisitedServers[targetJobId] = true

            SaveConfig()

            CountdownNotify("Hopping in", 5, function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
            end)
        end)

        if not success then
            BossHopInProgress = false
            if os.clock() - BossHopNotifyCooldown > 5 then
                BossHopNotifyCooldown = os.clock()
                Notify({
                    Title = "Boss Server Hop",
                    Description = "Hop failed: " .. tostring(err),
                    Duration = 4,
                    Icon = true
                })
            end
        end
    end)
end

