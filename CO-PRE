local function normalizeToolText(value)
    if typeof(value) == "string" then
        return value:gsub("%s+", ""):gsub("_", ""):gsub("-", ""):lower()
    end
    return nil
end

local function isGuiVisibleForCombat(obj)
    local current = obj
    local playerGui = Player:FindFirstChild("PlayerGui")

    while current and current ~= playerGui do
        if current:IsA("ScreenGui") and current.Enabled == false then
            return false
        end

        if current:IsA("GuiObject") and current.Visible == false then
            return false
        end

        current = current.Parent
    end

    return true
end

local function getCombatGuiText(obj)
    local texts = { tostring(obj.Name or "") }

    if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
        table.insert(texts, tostring(obj.Text or ""))
    end

    for _, child in ipairs(obj:GetDescendants()) do
        table.insert(texts, tostring(child.Name or ""))
        if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
            table.insert(texts, tostring(child.Text or ""))
        end
    end

    return table.concat(texts, " ")
end

local function clickGuiButtonForCombat(button)
    if not button or not button.Parent then return false end

    local clicked = false

    pcall(function()
        if firesignal then
            firesignal(button.MouseButton1Down)
            firesignal(button.MouseButton1Click)
            firesignal(button.MouseButton1Up)
            firesignal(button.Activated)
            clicked = true
        end
    end)

    pcall(function()
        if getconnections then
            for _, connection in ipairs(getconnections(button.MouseButton1Click)) do
                pcall(function() connection:Fire() end)
                clicked = true
            end

            for _, connection in ipairs(getconnections(button.Activated)) do
                pcall(function() connection:Fire() end)
                clicked = true
            end
        end
    end)

    pcall(function()
        local position = button.AbsolutePosition + (button.AbsoluteSize / 2)
        VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 0)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
        clicked = true
    end)

    return clicked
end

local function clickHotbarToolByName(toolName)
    toolName = tostring(toolName or "")
    if toolName == "" or toolName == "Auto" then return false end

    local playerGui = Player:FindFirstChild("PlayerGui")
    local camera = Workspace.CurrentCamera
    if not playerGui or not camera then return false end

    local wanted = normalizeToolText(toolName)
    if not wanted then return false end

    local minY = camera.ViewportSize.Y * 0.55
    local bestButton = nil

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and isGuiVisibleForCombat(obj) then
            local pos = obj.AbsolutePosition
            local size = obj.AbsoluteSize


            if pos.Y + (size.Y / 2) >= minY then
                local text = normalizeToolText(getCombatGuiText(obj)) or ""
