                elseif obj:IsA("Model") then
                    addDungeonMobCandidate(obj, mobs, seen)
                end
            end
        end
    end

    for _, tagName in ipairs({ "AI", "NPC", "Mob", "Enemy", "DungeonMob" }) do
        pcall(function()
            for _, model in ipairs(CollectionService:GetTagged(tagName)) do
                addDungeonMobCandidate(model, mobs, seen)
            end
        end)
