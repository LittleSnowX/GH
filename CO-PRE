local function attackDungeonMobs(mobs)
    local char = getCharacter()
    local root = getRoot(char)
    local tool = getTool(char)
    local hum = getHumanoid(char)

    if not root or not tool or not hum or hum.Health <= 0 then return end

    local selectedCombat = tostring(getgenv().SelectedCombat or "Auto")
    if selectedCombat ~= "" and selectedCombat ~= "Auto" and tool.Name ~= selectedCombat then
        return
    end

    local toolData = ToolDatas[tool.Name]
    if not toolData then return end

    local validMobs = {}
    for _, mob in ipairs(mobs or {}) do
        if isDungeonMobModel(mob) then
            table.insert(validMobs, mob)
        end
    end

    if #validMobs <= 0 then return end

    local repeated = {}
    local mult = tonumber(getgenv().DmgMultiplier) or 1
    mult = math.clamp(math.floor(mult), 1, 5000)

    for _, mob in ipairs(validMobs) do
        for _ = 1, mult do
            table.insert(repeated, mob)
        end
    end

    local combo = hum:GetAttribute("Combo") or 1
    local impactTime = Utils.predictImpactTime(Player, toolData.AttackSpeed or 0.5)

    CombatRemote:FireServer(tool.Name, repeated, combo, impactTime, os.clock())

    if combo < (toolData.MaxCombo or 5) then
        hum:SetAttribute("Combo", combo + 1)
        hum:SetAttribute("LastM1", os.clock())
    else
        hum:SetAttribute("Combo", 1)
        hum:SetAttribute("LastM1", os.clock() + (toolData.ComboCooldown or 0))
    end
end

local function warpToDungeonMob(targetMob)
    local char = getCharacter()
    local root = getRoot(char)
    local mobRoot = targetMob and targetMob:FindFirstChild("HumanoidRootPart")

    if not char or not root or not mobRoot then return end

    local offset = mobRoot.CFrame.LookVector * -DUNGEON_FARM_OFFSET
    char:PivotTo(CFrame.lookAt(mobRoot.Position + offset, mobRoot.Position))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function warpToDungeonWave(position)
    local char = getCharacter()
    local root = getRoot(char)

    if not char or not root or not position then return end

    char:PivotTo(CFrame.new(position + Vector3.new(0, 5, 0)))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end


local LastDungeonPortalTouch = 0
local DUNGEON_PORTAL_TOUCH_COOLDOWN = 3

local function getDungeonPortalFaseCandidates(wave)
    wave = tonumber(wave) or 1

    local candidates = {}
    local seen = {}

    local function addFaseNumber(n)
        n = tonumber(n)
        if n and n >= 1 and not seen[n] then
            seen[n] = true
            table.insert(candidates, n)
        end
    end


    addFaseNumber(wave)


    if wave >= 4 then
        addFaseNumber(1)
        addFaseNumber(((wave - 1) % 3) + 1)
    else
        addFaseNumber(math.clamp(wave, 1, 3))
    end


    addFaseNumber(1)
    addFaseNumber(2)
    addFaseNumber(3)
    addFaseNumber(4)
    addFaseNumber(5)

    return candidates
end

local function isDungeonPortalPart(part, wantedCube)
    if not part or not part:IsA("BasePart") then
        return false
    end

    local full = ""
    pcall(function()
        full = part:GetFullName()
    end)

    local fullLower = full:lower()

    return fullLower:find("masmorra", 1, true) ~= nil
        and full:find(wantedCube, 1, true) ~= nil
end

local function findDungeonPortal(wave)
    wave = tonumber(wave) or tonumber(Player:GetAttribute("DungeonWave")) or 1

    local wantedCube = wave >= 4 and "Cube.004" or "Cube.001"
    local char = getCharacter()
    local root = getRoot(char)

    local waves = getDungeonWaveFolders()
    local currentWaveInfo = getWaveInfoByNumber(waves, wave)
    local nextWaveInfo = getWaveInfoByNumber(waves, wave + 1)
    local currentWavePosition = currentWaveInfo and getWavePosition(currentWaveInfo.Folder)
    local nextWavePosition = nextWaveInfo and getWavePosition(nextWaveInfo.Folder)

    local function collectFromFase(faseNumber, cubeName)
        local list = {}
        local fase = Workspace:FindFirstChild("fase " .. tostring(faseNumber))
        if not fase then
            return list
        end

        for _, obj in ipairs(fase:GetDescendants()) do
            if isDungeonPortalPart(obj, cubeName) then
                local distanceToPlayer = root and (root.Position - obj.Position).Magnitude or math.huge
                local distanceToNextWave = nextWavePosition and (nextWavePosition - obj.Position).Magnitude or math.huge
                local distanceFromCurrentWave = currentWavePosition and (currentWavePosition - obj.Position).Magnitude or 0

                table.insert(list, {
                    Part = obj,
                    Distance = distanceToPlayer,
                    DistanceToNextWave = distanceToNextWave,
                    DistanceFromCurrentWave = distanceFromCurrentWave,
                    Fase = faseNumber,
                    Cube = cubeName,
                })
            end
        end

        return list
    end

    local function appendCandidates(dst, srcList)
        for _, item in ipairs(srcList or {}) do
            table.insert(dst, item)
        end
    end

    local portalCandidates = {}


    if wave >= 1 and wave <= 3 then
        appendCandidates(portalCandidates, collectFromFase(wave, wantedCube))
    elseif wave >= 4 then

        for _, faseNumber in ipairs(getDungeonPortalFaseCandidates(wave)) do
            appendCandidates(portalCandidates, collectFromFase(faseNumber, wantedCube))
            if #portalCandidates > 0 then
                break
            end
        end
    end


    if #portalCandidates == 0 then
        for _, faseNumber in ipairs(getDungeonPortalFaseCandidates(wave)) do
            appendCandidates(portalCandidates, collectFromFase(faseNumber, wantedCube))
            if #portalCandidates > 0 then
                break
            end
        end
    end

    if #portalCandidates == 0 then
        local fallbackCube = wantedCube == "Cube.004" and "Cube.001" or "Cube.004"
        for _, faseNumber in ipairs(getDungeonPortalFaseCandidates(wave)) do
            appendCandidates(portalCandidates, collectFromFase(faseNumber, fallbackCube))
            if #portalCandidates > 0 then
                break
            end
        end
    end

    if #portalCandidates == 0 then
        return nil
    end

    if wave >= 1 and wave <= 3 then
        if nextWavePosition then
            table.sort(portalCandidates, function(a, b)
                if math.abs(a.DistanceToNextWave - b.DistanceToNextWave) > 1 then
                    return a.DistanceToNextWave < b.DistanceToNextWave
                end
                return a.DistanceFromCurrentWave > b.DistanceFromCurrentWave
            end)
        elseif currentWavePosition then

            table.sort(portalCandidates, function(a, b)
                return a.DistanceFromCurrentWave > b.DistanceFromCurrentWave
            end)
        else

            table.sort(portalCandidates, function(a, b)
                return a.Distance < b.Distance
            end)
        end
    else

        table.sort(portalCandidates, function(a, b)
            return a.Distance < b.Distance
        end)
    end

    return portalCandidates[1].Part
end

local function touchDungeonPortal(portal)
    local char = getCharacter()
    local root = getRoot(char)

    if not char or not root or not portal then
        return false
    end

    local cf = portal.CFrame

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero


    pcall(function()
        char:PivotTo(cf * CFrame.new(0, 0, -7))
    end)
    task.wait(0.12)

    pcall(function()
        char:PivotTo(cf)
    end)
    task.wait(0.18)

    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, portal, 0)
            task.wait(0.05)
            firetouchinterest(root, portal, 1)
        end
    end)

    pcall(function()
        char:PivotTo(cf * CFrame.new(0, 0, 7))
    end)
    task.wait(0.12)

    pcall(function()
        char:PivotTo(cf)
    end)
    task.wait(0.18)

    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, portal, 0)
            task.wait(0.05)
            firetouchinterest(root, portal, 1)
        end
    end)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end

local function tryTouchDungeonPortal()
    if os.clock() - LastDungeonPortalTouch < DUNGEON_PORTAL_TOUCH_COOLDOWN then
        return false
    end

    if Player:GetAttribute("DungeonActive") ~= true then
        return false
    end

    local enemyCount = tonumber(Player:GetAttribute("DungeonEnemies")) or 0
    if enemyCount > 0 then
        return false
    end

    local wave = tonumber(Player:GetAttribute("DungeonWave")) or 1
    local portal = findDungeonPortal(wave)

    if not portal then
        return false
    end

    LastDungeonPortalTouch = os.clock()
    return touchDungeonPortal(portal)
end

local function doAutoClearDungeon()


    local enemyCount = tonumber(Player:GetAttribute("DungeonEnemies")) or 0
    if enemyCount <= 0 then
        tryTouchDungeonPortal()
        return
    end

    local waves = getDungeonWaveFolders()

    if #waves <= 0 then

        local mobs = getAllDungeonMobs()
        local target = getClosestMobFromList(mobs)
        if target then
            warpToDungeonMob(target)
            task.wait(0.03)
            attackDungeonMobs(getMobsNearMob(target, DUNGEON_ATTACK_RADIUS))
        end
        return
    end

    local waveNumber = getDungeonWaveNumber()
    local waveInfo = getWaveInfoByNumber(waves, waveNumber)
    if waveInfo then
        DungeonCurrentWaveIndex = table.find(waves, waveInfo) or DungeonCurrentWaveIndex
    end

    local wavePosition = waveInfo and getWavePosition(waveInfo.Folder)
    local mobs = wavePosition and getMobsNearPosition(wavePosition, DUNGEON_WAVE_RADIUS) or {}


    if #mobs <= 0 and enemyCount > 0 then
        mobs = getAllDungeonMobs()
    end

    if #mobs > 0 then
        DungeonNoMobSince = nil

        local target = getClosestMobFromList(mobs)
        if target then
            warpToDungeonMob(target)
            task.wait(0.03)


            local focusedMobs = getMobsNearMob(target, DUNGEON_ATTACK_RADIUS)
            attackDungeonMobs(focusedMobs)
        end

        return
    end


    if not DungeonNoMobSince then
        DungeonNoMobSince = os.clock()
    end
end

