local function getWaveInfoByNumber(waves, waveNumber)
    if type(waves) ~= "table" then return nil end
    for _, waveInfo in ipairs(waves) do
        if waveInfo.Number == waveNumber then
            return waveInfo
        end
    end
    return waves[math.clamp(waveNumber or 1, 1, #waves)]
end

local function getAllDungeonMobs()
