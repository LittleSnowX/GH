local function CreateFloatingIcon()
    if btnGuiObj then pcall(function() btnGuiObj:Destroy() end) end

    local parent = (gethui and gethui()) or game:GetService("CoreGui") or PlayerGui
    local btnSize = 50

    btnGuiObj = Instance.new("ScreenGui")
    btnGuiObj.Name = "GhostHub_Toggle"
    btnGuiObj.ResetOnSpawn = false
    btnGuiObj.IgnoreGuiInset = true
    btnGuiObj.DisplayOrder = 9999999
    btnGuiObj.Parent = parent

    btnFrame = Instance.new("Frame")
    btnFrame.Name = "ToggleButtonContainer"
    btnFrame.Size = UDim2.new(0, btnSize, 0, btnSize)
    btnFrame.Position = UDim2.new(0.5, -25, 0.1, -25)
    btnFrame.BackgroundTransparency = 1
    btnFrame.Parent = btnGuiObj

    local btnImg = Instance.new("ImageButton")
    btnImg.Name = "ToggleButton"
    btnImg.Parent = btnFrame
    btnImg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btnImg.BackgroundTransparency = 0
    btnImg.AnchorPoint = Vector2.new(0.5, 0.5)
    btnImg.Position = UDim2.new(0.5, 0, 0.5, 0)
    btnImg.Size = UDim2.new(1, 0, 1, 0)
    btnImg.Image = "rbxassetid://110552700896064"
    btnImg.ZIndex = 100
    Instance.new("UICorner", btnImg).CornerRadius = UDim.new(1, 0)

    local isDragging, dragInput, dragStart, startPos, hasMoved = false, nil, nil, nil, false

    btnImg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragInput, dragStart, startPos = input, input.Position, btnFrame.Position
            isDragging, hasMoved = true, false
            TweenService:Create(btnImg, TweenInfo.new(0.1), {Size = UDim2.new(0.8, 0, 0.8, 0)}):Play()

            local conn; conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    conn:Disconnect()
                    isDragging = false
                    TweenService:Create(btnImg, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.new(1, 0, 1, 0)}):Play()
                    if not hasMoved and type(toggleWindow) == "function" then toggleWindow() end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 15 then
                hasMoved = true
                btnFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)
end

