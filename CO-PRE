                pcall(function()
                    local interface = PlayerGui:FindFirstChild("Interface Player")
                    if interface then
                        local label = interface:FindFirstChild("LabelYens", true)
                        if label and label:IsA("TextLabel") then
                            yenAmount = parseYen(label.Text)
                        end
                    end
                end)
                
                if yenAmount == 0 then
                    local yenAttr = Player:GetAttribute("Yen") or Player:GetAttribute("Coins") 
                                or (Player:FindFirstChild("leaderstats") and (Player.leaderstats:FindFirstChild("Yen") or Player.leaderstats:FindFirstChild("Coins")))
                    if yenAttr then
                        if typeof(yenAttr) == "Instance" then
                            yenAmount = tonumber(yenAttr.Value) or 0
                        else
                            yenAmount = tonumber(yenAttr) or 0
                        end
                    end
                end

                labels.currency.Title = "Money: " .. formatComma(yenAmount)

                local currentQuest = Player:GetAttribute("CurrentQuest")
                if currentQuest and currentQuest ~= "" then
                    labels.quest.Title = "Quest: " .. currentQuest
                else
                    labels.quest.Title = "Quest: None"
                end

                local uptime = os.clock() - startTime
                local hours = math.floor(uptime / 3600)
                local mins = math.floor((uptime % 3600) / 60)
                local secs = math.floor(uptime % 60)
                labels.time.Title = string.format("Uptime: %02d:%02d:%02d", hours, mins, secs)

                local pingStats = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
                local ping = tonumber(pingStats:match("%d+")) or 0
                labels.ping.Title = "Ping: " .. tostring(ping) .. " ms"

                local currentClock = os.clock()
