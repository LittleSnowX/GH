local function readValueObject(obj)
    if not obj then return nil end
    if obj:IsA("StringValue") then return obj.Value
    elseif obj:IsA("ObjectValue") and obj.Value then return obj.Value.Name
    elseif obj:IsA("IntValue") or obj:IsA("NumberValue") then return tostring(obj.Value) end
    return nil
end

local function scanAttributes(instance)
    if not instance then return nil end
    local attrNames = {"Grimoire", "CurrentGrimoire", "EquippedGrimoire", "Magic", "CurrentMagic", "MagicType", "Element"}
    for _, attr in ipairs(attrNames) do
        local found = resolveGrimoireName(instance:GetAttribute(attr))
        if found then return found end
    end
    for _, attr in pairs(instance:GetAttributes()) do
        local found = resolveGrimoireName(attr)
        if found then return found end
    end
    return nil
end

local function scanContainer(container)
    if not container then return nil end
    local found = scanAttributes(container) or resolveGrimoireName(container.Name) or resolveGrimoireName(readValueObject(container))
    if found then return found end
    for _, obj in ipairs(container:GetDescendants()) do
        found = scanAttributes(obj) or resolveGrimoireName(obj.Name) or resolveGrimoireName(readValueObject(obj))
        if found then return found end
    end
    return nil
end

