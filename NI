-- ==========================================
-- Main Loop 1: Core Combat, Mining & Trial System
-- ==========================================
task.spawn(function()
    while task.wait() do 
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end

        checkAutoJoinTime(char)
        checkAutoLeaveWave()

        if IsJoiningTrial then continue end

        local targetTrialMob = nil
        if AutoEasyTrial then
            targetTrialMob = getValidTrialMob()
        end

        if targetTrialMob then
            char:PivotTo(targetTrialMob:GetPivot())
            
            while AutoEasyTrial and targetTrialMob.Parent do
                local hpText = getEntityHealth(targetTrialMob)
                if isEntityDead(hpText) then break end
                task.wait()
            end
            
        elseif AutoMine and SelectedOres then
            local targetOre = getValidOre(SelectedOres)
            
            if targetOre then
                char:PivotTo(targetOre:GetPivot())
                
                while AutoMine and targetOre.Parent do
                    local hpText = getEntityHealth(targetOre)
                    if isEntityDead(hpText) then break end
                    task.wait()
                end
            end

        elseif AutoTeleport and SelectedMobs then
            local targetMob = getValidMob(SelectedMobs)
            
            if targetMob then
                char:PivotTo(targetMob:GetPivot())
                
                while AutoTeleport and targetMob.Parent do
                    local hpText = getEntityHealth(targetMob)
                    if isEntityDead(hpText) then break end
                    task.wait()
                end
            end
        end
    end
end)

