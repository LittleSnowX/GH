-- ==========================================
-- Main Loop 4: Auto Spirit Ritual & Status Update
-- ==========================================
task.spawn(function()
    while task.wait(0.5) do
        local currentTime = os.time()
        
        if AutoSpiritRitual then
            if currentTime >= CooldownEndTime then
                if MainRemote then
                    MainRemote:FireServer("StartRitual")
                end
                RitualState = "Active"
                RitualKills = 0
                RitualEndTime = currentTime + 120
                CooldownEndTime = RitualEndTime + 35
                
            elseif currentTime < RitualEndTime then
                RitualState = "Active"
            elseif currentTime < CooldownEndTime then
                RitualState = "Cooldown"
            end
        else
            RitualState = "Idle"
        end
        
        if RitualState == "Idle" then
            RitualStatus:SetDesc("Status: Idle\nKills: 0\nTime Left: 0s")
        elseif RitualState == "Active" then
            local timeLeft = RitualEndTime - currentTime
            if timeLeft < 0 then timeLeft = 0 end
            RitualStatus:SetDesc("Status: Active (Killing Mobs)\nKills: " .. tostring(RitualKills) .. "\nTime Left: " .. tostring(timeLeft) .. "s")
        elseif RitualState == "Cooldown" then
            local timeLeft = CooldownEndTime - currentTime
            if timeLeft < 0 then timeLeft = 0 end
            RitualStatus:SetDesc("Status: Cooldown\nKills: " .. tostring(RitualKills) .. " (Finished)\nTime Left: " .. tostring(timeLeft) .. "s")
        end
    end
end)

