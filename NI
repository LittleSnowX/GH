local function getEntityHealth(entity)
    local oresUI = entity:FindFirstChild("OresTopUI")
    if oresUI then
        local bar = oresUI:FindFirstChild("Bar")
        if bar then
            local healthNode = bar:FindFirstChild("Health")
            if healthNode then
                if healthNode:IsA("TextLabel") or healthNode:IsA("TextButton") then
                    return healthNode.Text
                elseif healthNode:IsA("StringValue") then
                    return healthNode.Value
                end
            end
        end
    end
    return nil
end

local function parseMaxHPFromText(hpText)
    if not hpText then return 0 end
    local text = tostring(hpText)
    local splitText = string.split(text, "/")
    local maxHpText = splitText[#splitText] 
    
    maxHpText = string.gsub(maxHpText, "%s+", "")
    maxHpText = string.gsub(maxHpText, ",", "")
    
    local multipliers = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12,
        QD = 1e15, QA = 1e15,
        QN = 1e18, QI = 1e18,
        SX = 1e21, SP = 1e24,
        OC = 1e27, NO = 1e30,
        DE = 1e33, UDE = 1e36,
        DDE = 1e39, TDE = 1e42,
        QDE = 1e45, QNDE = 1e48,
        SXDE = 1e51, SPDE = 1e54,
        OCDE = 1e57, NODE = 1e60,
        VG = 1e63
    }
    
    local numStr, suffix = string.match(maxHpText, "([%d%.]+)([a-zA-Z]*)")
    
    if numStr then
        local val = tonumber(numStr) or 0
        suffix = string.upper(suffix or "")
        local mult = multipliers[suffix] or 1
        return val * mult
    end
    
    return 0
end

local function getEntityMaxHP(targetName, parentPath)
    local highestFound = 0
    
    for _, entity in ipairs(parentPath:GetChildren()) do
        if entity.Name == targetName then
            local hpText = getEntityHealth(entity)
            if hpText and not string.find(tostring(hpText), "Respawning") then
                local val = parseMaxHPFromText(hpText)
                if val > highestFound then
                    highestFound = val
                end
            end
        end
    end
    
    return highestFound > 0 and highestFound or math.huge 
end

local function getUniqueEntitiesSorted(parentPath)
    local uniqueCheck = {}
    local dataList = {}
    
    for _, entity in ipairs(parentPath:GetChildren()) do
        if not uniqueCheck[entity.Name] then
            uniqueCheck[entity.Name] = true
            local maxHpValue = getEntityMaxHP(entity.Name, parentPath)
            table.insert(dataList, {
                Name = entity.Name,
                MaxHP = maxHpValue
            })
        end
    end
    
    table.sort(dataList, function(a, b)
        return a.MaxHP < b.MaxHP
    end)
    
    local sortedNames = {}
    for _, data in ipairs(dataList) do
        table.insert(sortedNames, data.Name)
    end
    
    return sortedNames
end

local function isEntityDead(hpText)
    if not hpText then return true end 
    local text = tostring(hpText)
    
    if string.find(text, "Respawning") then return true end
    if text == "0" or string.match(text, "^0[a-zA-Z]+$") then return true end
    if string.match(text, "^0%s*/") then return true end
    
    return false
end

local function getValidOre(targetNamesMap)
    if not targetNamesMap or type(targetNamesMap) ~= "table" then return nil end
    
    local bestOre = nil
    local highestHP = -1
    
    for _, ore in ipairs(oresPath:GetChildren()) do
        if targetNamesMap[ore.Name] then
            local hpText = getEntityHealth(ore)
            if not isEntityDead(hpText) then
                local currentMaxHP = parseMaxHPFromText(hpText)
                if currentMaxHP > highestHP then
                    highestHP = currentMaxHP
                    bestOre = ore
                end
            end
        end
    end
    
    return bestOre
end

local function getValidMob(targetNamesMap)
    if not targetNamesMap or type(targetNamesMap) ~= "table" then return nil end
    
    local bestMob = nil
    local highestHP = -1
    
    for _, mob in ipairs(mobsPath:GetChildren()) do
        if targetNamesMap[mob.Name] then
            local hpText = getEntityHealth(mob)
            if not isEntityDead(hpText) then
                local currentMaxHP = parseMaxHPFromText(hpText)
                if currentMaxHP > highestHP then
                    highestHP = currentMaxHP
                    bestMob = mob
                end
            end
        end
    end
    
    return bestMob
end

local function getValidTrialMob()
    local content = workspace:FindFirstChild("__GAME_CONTENT")
    if not content then return nil end
    
    local trials = content:FindFirstChild("Trials")
    if not trials then return nil end
    
    local easyRoom = trials:FindFirstChild("EasyTrialRoom")
    if not easyRoom then return nil end
    
    local trialMobs = easyRoom:FindFirstChild("Mobs")
    if not trialMobs then return nil end

    for _, mob in ipairs(trialMobs:GetChildren()) do
        local hpText = getEntityHealth(mob)
        if not isEntityDead(hpText) then
            return mob
        end
    end
    return nil
end

local function checkAutoJoinTime(char)
    if not AutoJoinTime or not char then return end
    
    local currentTime = os.date("*t")
    local min = currentTime.min
    local sec = currentTime.sec
    
    if ((min == 29 and sec >= 30) or (min == 59 and sec >= 30)) and min ~= LastJoinMinute then
        LastJoinMinute = min 
        
        local touchPart = workspace:FindFirstChild("__GAME_CONTENT")
            and workspace.__GAME_CONTENT:FindFirstChild("Trials")
            and workspace.__GAME_CONTENT.Trials:FindFirstChild("EasyTrialRoom")
            and workspace.__GAME_CONTENT.Trials.EasyTrialRoom:FindFirstChild("__TrialEasyRoom")
            and workspace.__GAME_CONTENT.Trials.EasyTrialRoom.__TrialEasyRoom:FindFirstChild("TouchPart")
            
        if touchPart then
            IsJoiningTrial = true
            char:PivotTo(touchPart.CFrame)
            
            task.delay(5, function()
                IsJoiningTrial = false
            end)
        end
    end
end

local function checkAutoLeaveWave()
    if not AutoLeaveWave then return end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    local waveUI = playerGui:FindFirstChild("FullScreen")
        and playerGui.FullScreen:FindFirstChild("Popups")
        and playerGui.FullScreen.Popups:FindFirstChild("TrialUI")
        and playerGui.FullScreen.Popups.TrialUI:FindFirstChild("Info")
        and playerGui.FullScreen.Popups.TrialUI.Info:FindFirstChild("WaveCount")
        
    if waveUI and waveUI:IsA("TextLabel") then
        local waveText = waveUI.Text
        local currentWave = tonumber(string.match(waveText, "%d+")) 
        
        if currentWave and currentWave >= TargetLeaveWave then
            MainRemote:FireServer("LeaveTrial")
            AutoLeaveWave = false 
            Fluent:Notify({
                Title = "Auto Leave",
                Content = "Left the trial at wave " .. tostring(currentWave),
                Duration = 3
            })
        end
    end
end

