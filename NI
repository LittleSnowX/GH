local function doWiggle(char)
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        hrp.CFrame = hrp.CFrame * CFrame.new(math.random(-3, 3), 0, math.random(-3, 3))
        hrp.AssemblyLinearVelocity = Vector3.new(0, 15, 0)
    end
end

local function smartTeleport(char, target)
    if not char or not target then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local targetCFrame = target:GetPivot()
        local offsetCFrame = targetCFrame * CFrame.new(0, 0, 4)
        char:PivotTo(CFrame.new(offsetCFrame.Position, targetCFrame.Position))
    end
end

