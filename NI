local function isTargetSelected(targetMap, name)
    if not targetMap then return false end
    if type(targetMap) == "string" then return targetMap == name end
    if type(targetMap) == "table" then
        if targetMap[name] then return true end
        for k, v in pairs(targetMap) do
            if type(k) == "number" and v == name then return true end
        end
    end
    return false
end

local function getEntityHealth(entity)
    local oresUI = entity:FindFirstChild("OresTopUI")
    if oresUI then
        local bar = oresUI:FindFirstChild("Bar")
        if bar then
            local healthNode = bar:FindFirstChild("Health")
            if healthNode then
                if healthNode:IsA("TextLabel") or healthNode:IsA("TextButton") then
                    return healthNode.Text
                elseif healthNode:IsA("StringValue") then
                    return healthNode.Value
                end
            end
        end
    end
    return nil
end

local function parseMaxHPFromText(hpText)
    if not hpText then return 0 end
    local text = tostring(hpText)
    local splitText = string.split(text, "/")
    local maxHpText = splitText[#splitText] 
    
    maxHpText = string.gsub(maxHpText, "%s+", "")
    maxHpText = string.gsub(maxHpText, ",", "")
    
    local multipliers = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12,
        QD = 1e15, QA = 1e15,
        QN = 1e18, QI = 1e18,
        SX = 1e21, SP = 1e24,
        OC = 1e27, NO = 1e30,
        DE = 1e33, UDE = 1e36,
        DDE = 1e39, TDE = 1e42,
        QDE = 1e45, QNDE = 1e48,
        SXDE = 1e51, SPDE = 1e54,
        OCDE = 1e57, NODE = 1e60,
        VG = 1e63
    }
    
    local numStr, suffix = string.match(maxHpText, "([%d%.]+)([a-zA-Z]*)")
    
    if numStr then
        local val = tonumber(numStr) or 0
        suffix = string.upper(suffix or "")
        local mult = multipliers[suffix] or 1
        return val * mult
    end
    return 0
end

local function getEntityMaxHP(targetName, parentFolder)
    if not parentFolder then return math.huge end
    local highestFound = 0
    
    for _, entity in ipairs(parentFolder:GetChildren()) do
        if entity.Name == targetName then
            local hpText = getEntityHealth(entity)
            if hpText and not string.find(tostring(hpText), "Respawning") then
                local val = parseMaxHPFromText(hpText)
                if val > highestFound then
                    highestFound = val
                end
            end
        end
    end
    return highestFound > 0 and highestFound or math.huge 
end

local function getUniqueEntitiesSorted(parentFolder)
    if not parentFolder then return {} end
    local uniqueCheck = {}
    local dataList = {}
    
    for _, entity in ipairs(parentFolder:GetChildren()) do
        if not uniqueCheck[entity.Name] then
            uniqueCheck[entity.Name] = true
            local maxHpValue = getEntityMaxHP(entity.Name, parentFolder)
            table.insert(dataList, {
                Name = entity.Name,
                MaxHP = maxHpValue
            })
        end
    end
    
    table.sort(dataList, function(a, b)
        return a.MaxHP < b.MaxHP
    end)
    
    local sortedNames = {}
    for _, data in ipairs(dataList) do
        table.insert(sortedNames, data.Name)
    end
    return sortedNames
end

local function isEntityDead(hpText)
    if not hpText then return true end 
    local text = tostring(hpText)
    
    if string.find(text, "Respawning") then return true end
    if text == "0" or string.match(text, "^0[a-zA-Z]+$") then return true end
    if string.match(text, "^0%s*/") then return true end
    return false
end

local function getValidOre(targetNamesMap)
    local oresFolder = getOresFolder()
    if not oresFolder or type(targetNamesMap) ~= "table" then return nil end
    
    local bestOre = nil
    local highestHP = -1
    
    for _, ore in ipairs(oresFolder:GetChildren()) do
        if isTargetSelected(targetNamesMap, ore.Name) then
            local hpText = getEntityHealth(ore)
            if not isEntityDead(hpText) then
                local currentMaxHP = parseMaxHPFromText(hpText)
                if currentMaxHP > highestHP then
                    highestHP = currentMaxHP
                    bestOre = ore
                end
            end
        end
    end
    return bestOre
end

local function getValidMob(targetNamesMap)
    local mobsFolder = getMobsFolder()
    if not mobsFolder or type(targetNamesMap) ~= "table" then return nil end
    
    local bestMob = nil
    local highestHP = -1
    
    for _, mob in ipairs(mobsFolder:GetChildren()) do
        if isTargetSelected(targetNamesMap, mob.Name) then
            local hpText = getEntityHealth(mob)
            if not isEntityDead(hpText) then
                local currentMaxHP = parseMaxHPFromText(hpText)
                if currentMaxHP > highestHP then
                    highestHP = currentMaxHP
                    bestMob = mob
                end
            end
        end
    end
    return bestMob
end

local function getValidTrialMob()
    local gc = getGameContent()
    if not gc then return nil end
    
    local trials = gc:FindFirstChild("Trials")
    if not trials then return nil end
    
    local easyRoom = trials:FindFirstChild("EasyTrialRoom")
    if not easyRoom then return nil end
    
    local trialMobs = easyRoom:FindFirstChild("Mobs")
    if not trialMobs then return nil end

    for _, mob in ipairs(trialMobs:GetChildren()) do
        local hpText = getEntityHealth(mob)
        if not isEntityDead(hpText) then
            return mob
        end
    end
    return nil
end

local function checkAutoJoinTime(char)
    if not AutoJoinTime or not char then return end
    
    local currentTime = os.date("*t")
    local min = currentTime.min
    local sec = currentTime.sec
    
    if ((min == 29 and sec >= 30) or (min == 59 and sec >= 30)) and min ~= LastJoinMinute then
        LastJoinMinute = min 
        
        local touchPart = getGameContent()
            and getGameContent():FindFirstChild("Trials")
            and getGameContent().Trials:FindFirstChild("EasyTrialRoom")
            and getGameContent().Trials.EasyTrialRoom:FindFirstChild("__TrialEasyRoom")
            and getGameContent().Trials.EasyTrialRoom.__TrialEasyRoom:FindFirstChild("TouchPart")
            
        if touchPart then
            IsJoiningTrial = true
            char:PivotTo(touchPart.CFrame)
            
            task.delay(5, function()
                IsJoiningTrial = false
            end)
        end
    end
end

local function checkAutoLeaveWave()
    if not AutoLeaveWave then return end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    local waveUI = playerGui:FindFirstChild("FullScreen")
        and playerGui.FullScreen:FindFirstChild("Popups")
        and playerGui.FullScreen.Popups:FindFirstChild("TrialUI")
        and playerGui.FullScreen.Popups.TrialUI:FindFirstChild("Info")
        and playerGui.FullScreen.Popups.TrialUI.Info:FindFirstChild("WaveCount")
        
    if waveUI and waveUI:IsA("TextLabel") then
        local waveText = waveUI.Text
        local currentWave = tonumber(string.match(waveText, "%d+")) 
        
        if currentWave and currentWave >= TargetLeaveWave then
            if MainRemote then
                MainRemote:FireServer("LeaveTrial")
                AutoLeaveWave = false 
                Fluent:Notify({
                    Title = "Auto Leave",
                    Content = "Left the trial at wave " .. tostring(currentWave),
                    Duration = 3
                })
            end
        end
    end
end

local function getAvailableCapsules()
    local list = {}
    local gc = getGameContent()
    if gc then
        local uiZones = gc:FindFirstChild("UIZones")
        if uiZones then
            for _, zone in ipairs(uiZones:GetChildren()) do
                if string.find(zone.Name, "Capsule") then
                    local cleanName = string.gsub(zone.Name, "__Capsule", "")
                    table.insert(list, cleanName)
                end
            end
        end
    end
    return list
end

local function getOwnedNoobs()
    local noobsFolder = getNoobsFolder()
    if not noobsFolder then return {} end
    
    local noobList = {}
    for _, noob in ipairs(noobsFolder:GetChildren()) do
        table.insert(noobList, noob.Name)
    end
    return noobList
end

local function getWarningEnchantName()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local enchantsUI = playerGui:FindFirstChild("Enchants")
    if not enchantsUI then return nil end
    
    local mainUI = enchantsUI:FindFirstChild("Main")
    if not mainUI then return nil end
    
    local warning = mainUI:FindFirstChild("Warning")
    if warning and warning.Visible then
        local frame = warning:FindFirstChild("Frame")
        if frame then
            local enchantNameLabel = frame:FindFirstChild("EnchantName")
            if enchantNameLabel and enchantNameLabel:IsA("TextLabel") then
                return string.match(enchantNameLabel.Text, "^%s*(.-)%s*$")
            end
        end
    end
    return nil
end

