    end
    return noobList
end

local function getWarningEnchantName()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local enchantsUI = playerGui:FindFirstChild("Enchants")
    if not enchantsUI then return nil end
    
    local mainUI = enchantsUI:FindFirstChild("Main")
    if not mainUI then return nil end
    
    local warning = mainUI:FindFirstChild("Warning")
    if warning and warning.Visible then
        local frame = warning:FindFirstChild("Frame")
        if frame then
            local enchantNameLabel = frame:FindFirstChild("EnchantName")
            if enchantNameLabel and enchantNameLabel:IsA("TextLabel") then
                return string.match(enchantNameLabel.Text, "^%s*(.-)%s*$")
            end
        end
    end
    
    return nil
end

