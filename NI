-- ==========================================
-- Main Loop 1: Core Combat, Mining & Trial System
-- ==========================================
task.spawn(function()
    while task.wait() do 
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end

        checkAutoJoinTime(char)
        checkAutoLeaveWave()

        if IsJoiningTrial then continue end

        local currentlyInTrial = false
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local trialUI = playerGui:FindFirstChild("FullScreen")
                and playerGui.FullScreen:FindFirstChild("Popups")
                and playerGui.FullScreen.Popups:FindFirstChild("TrialUI")
                
            if trialUI and trialUI.Visible then
                currentlyInTrial = true
            end
        end

        if wasInTrial and not currentlyInTrial then
            if AutoCapsule and SelectedCapsule then
                local gc = getGameContent()
                if gc then
                    local uiZones = gc:FindFirstChild("UIZones")
                    if uiZones then
                        local targetZone = uiZones:FindFirstChild("__Capsule" .. SelectedCapsule) or uiZones:FindFirstChild(SelectedCapsule)
                        if targetZone then
                            char:PivotTo(targetZone:GetPivot())
                            task.wait(3) 
                            
                            if MainRemote then
                                MainRemote:FireServer("ToggleMinionAutoOpen", SelectedCapsule)
                                Fluent:Notify({
                                    Title = "Auto Capsule",
                                    Content = "Fired Remote: " .. SelectedCapsule,
                                    Duration = 3
                                })
                            end
                        end
                    end
                end
            end
        end
        wasInTrial = currentlyInTrial

        -- == Trial Farming ==
        if currentlyInTrial and AutoEasyTrial then
            local targetTrialMob = getValidTrialMob()
            if targetTrialMob then
                task.wait(TeleportDelay)
                if targetTrialMob.Parent then
                    smartTeleport(char, targetTrialMob)
                    
                    local lastHpText = getEntityHealth(targetTrialMob)
                    local stuckTimer = 0
                    
                    while AutoEasyTrial and targetTrialMob.Parent do
                        local hpText = getEntityHealth(targetTrialMob)
                        if isEntityDead(hpText) then 
                            if RitualState == "Active" then RitualKills = RitualKills + 1 end
                            break 
                        end
                        
                        if hpText == lastHpText then
                            stuckTimer = stuckTimer + task.wait()
                            if stuckTimer > 3.5 then
                                doWiggle(char)
                                stuckTimer = 0
                            end
                        else
                            lastHpText = hpText
                            stuckTimer = 0
                            task.wait()
                        end
                    end
                end
            end
            continue
        end

        local targetOre = nil
        if AutoMine and SelectedOres then
            targetOre = getValidOre(SelectedOres)
        end

        local targetMob = nil
        if AutoTeleport and SelectedMobs then
            targetMob = getValidMob(SelectedMobs)
        end

        -- == Ore Mining ==
        if targetOre then
            task.wait(TeleportDelay)
            if targetOre.Parent then
                smartTeleport(char, targetOre)
                
                local lastHpText = getEntityHealth(targetOre)
                local stuckTimer = 0
                
                while AutoMine and targetOre.Parent do
                    local hpText = getEntityHealth(targetOre)
                    if isEntityDead(hpText) then break end
                    
                    if hpText == lastHpText then
                        stuckTimer = stuckTimer + task.wait()
                        if stuckTimer > 3.5 then
                            doWiggle(char)
                            stuckTimer = 0
                        end
                    else
                        lastHpText = hpText
                        stuckTimer = 0
                        task.wait()
                    end
                end
            end

        -- == Mob Farming ==
        elseif targetMob then
            task.wait(TeleportDelay)
            if targetMob.Parent then
                smartTeleport(char, targetMob)
                
                local lastHpText = getEntityHealth(targetMob)
                local stuckTimer = 0
                
                while AutoTeleport and targetMob.Parent do
                    local hpText = getEntityHealth(targetMob)
                    if isEntityDead(hpText) then 
                        if RitualState == "Active" then RitualKills = RitualKills + 1 end
                        break 
                    end
                    
                    if hpText == lastHpText then
                        stuckTimer = stuckTimer + task.wait()
                        if stuckTimer > 3.5 then
                            doWiggle(char)
                            stuckTimer = 0
                        end
                    else
                        lastHpText = hpText
                        stuckTimer = 0
                        task.wait()
                    end
                end
            end
            
        -- == Return to Saved Position ==
        elseif ReturnToSavedPosition and SavedPosition then
            if (char.HumanoidRootPart.Position - SavedPosition.Position).Magnitude > 5 then
                char:PivotTo(SavedPosition)
            end
        end
    end
end)

